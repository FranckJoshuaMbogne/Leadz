# Public site URL used for canonical URLs, Open Graph and sitemap.xml.
# Set this once the production domain is confirmed.
VITE_SITE_URL=https://leadzindb.web.app

# Public contact email (hidden on the site while empty)
VITE_CONTACT_EMAIL=

# Optional: also POST every lead to a CRM / Zapier / Make webhook
VITE_LEAD_WEBHOOK_URL=

# Set to "false" to disable the Firestore Insights CMS
VITE_CMS_ENABLED=true

# Firebase web config (defaults to the existing leadzindb project)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Build: set to "false" to skip fetching CMS articles during prerender
PRERENDER_CMS=true
